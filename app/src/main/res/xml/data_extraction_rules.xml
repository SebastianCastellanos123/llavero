<?xml version="1.0" encoding="utf-8"?><!--
   Desde Android 12, allowBackup="false" apaga la copia en la nube pero no la
   transferencia directa entre teléfonos. Aquí se excluye todo en ambos casos:
   las cuentas solo salen del teléfono con el respaldo cifrado propio de la app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
